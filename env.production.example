# ===========================================
# DRAFTY APPLICATION - PRODUCTION CONFIGURATION
# ===========================================
# Configuración específica para despliegue en producción en Huawei Cloud
# Copia este archivo a .env y actualiza con tus valores reales
# 
# ⚠️  SECURITY WARNING: 
# - Never commit .env files to version control
# - Replace all placeholder values with real credentials
# - Keep this file secure and private

# ===========================================
# 🤖 AI MODULE CONFIGURATION (Local Only)
# ===========================================

AI_MODEL=gpt-4o
AI_OPENAI_API_KEY=your_openai_api_key_here
AI_HF_TOKEN=your_huggingface_token_here

# ===========================================
# 🗄️ DATABASE CONFIGURATION (Backend)
# ===========================================
# Huawei Cloud DDS (Document Database Service) - MongoDB

DATABASE_TYPE=mongodb
DATABASE_URI=mongodb://username:password@your_dds_ip:8635/your_database?authSource=admin&replicaSet=replica
DATABASE_NAME=your_database_name

# ===========================================
# 📁 FILE STORAGE CONFIGURATION (Backend)
# ===========================================
# Huawei Cloud OBS (Object Storage Service)

STORAGE_TYPE=huawei_obs
STORAGE_OBS_ENDPOINT=https://obs.ap-southeast-1.myhuaweicloud.com
STORAGE_OBS_BUCKET_NAME=your_bucket_name
STORAGE_OBS_ACCESS_KEY=your_obs_access_key
STORAGE_OBS_SECRET_KEY=your_obs_secret_key
STORAGE_OBS_REGION=ap-southeast-1

# ===========================================
# 🌐 FRONTEND CONFIGURATION (Build-time)
# ===========================================
# IMPORTANTE: Actualizar FRONTEND_API_URL con la IP pública de tu ECS

FRONTEND_API_URL=http://your_ecs_public_ip:8000
FRONTEND_ENVIRONMENT=production
FRONTEND_DEBUG=false

# ===========================================
# ⚙️ BACKEND APPLICATION CONFIGURATION
# ===========================================

BACKEND_ENVIRONMENT=production
BACKEND_DEBUG=false
BACKEND_LOG_LEVEL=INFO
BACKEND_SECRET_KEY=your_production_secret_key_here_change_this

# ===========================================
# 📝 NOTAS IMPORTANTES
# ===========================================
# 1. Cambiar BACKEND_SECRET_KEY por una clave segura
# 2. Actualizar FRONTEND_API_URL con la IP real de tu ECS
# 3. Verificar que todas las credenciales de OBS sean correctas
# 4. Ejecutar: python3 verify-env.py para verificar configuración
