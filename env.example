# ===========================================
# DRAFTY APPLICATION CONFIGURATION
# ===========================================
# This is the MAIN configuration file for the entire application
# Copy this to .env and update with your actual values

# ===========================================
# 🤖 AI CONFIGURATION
# ===========================================
AI_DEEPSEEK_MODEL=deepseek-r1-distil-qwen-32b_raziqt
AI_DEEPSEEK_BASE_URL=https://pangu.ap-southeast-1.myhuaweicloud.com/api/v2/chat/completions
AI_OPENAI_MODEL=gpt-4o
DEEPSEEK_API_KEY=replace_with_your_key
OPENAI_API_KEY=replace_with_your_key

# ===========================================
# 🗄️ DATABASE CONFIGURATION (Backend)
# ===========================================
# Huawei Cloud DDS (Document Database Service) - MongoDB
# Used by backend/database.py

DATABASE_TYPE=mongodb
DATABASE_URI=mongodb://username:password@your_dds_ip:8635/your_database?authSource=admin&replicaSet=replica
DATABASE_NAME=your_database_name

# ===========================================
# 📁 FILE STORAGE CONFIGURATION (Backend)
# ===========================================
# Huawei Cloud OBS (Object Storage Service)
# Used by backend/storage.py

STORAGE_TYPE=huawei_obs
STORAGE_OBS_ENDPOINT=https://obs.ap-southeast-1.myhuaweicloud.com
STORAGE_OBS_BUCKET_NAME=your_bucket_name
STORAGE_OBS_ACCESS_KEY=your_obs_access_key
STORAGE_OBS_SECRET_KEY=your_obs_secret_key
STORAGE_OBS_REGION=ap-southeast-1

# ===========================================
# 🌐 FRONTEND CONFIGURATION (Build-time)
# ===========================================
# These variables are used during frontend build process
# They become VITE_* variables in the built application

# For local development
FRONTEND_API_URL=http://localhost:8000
FRONTEND_ENVIRONMENT=development
FRONTEND_DEBUG=false

# ===========================================
# ⚙️ BACKEND APPLICATION CONFIGURATION
# ===========================================
# General application settings used by backend/main.py

BACKEND_ENVIRONMENT=development
BACKEND_DEBUG=false
BACKEND_LOG_LEVEL=INFO
BACKEND_SECRET_KEY=your_secret_key_for_jwt_tokens
